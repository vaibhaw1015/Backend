{
	"info": {
		"_postman_id": "Fundsroom-ERP-CRM-Collection",
		"name": "Fundsroom Wholesale ERP/CRM API",
		"description": "Complete Postman Collection for Fundsroom Wholesale ERP/CRM API system covering Auth, Customers CRM, Products/Inventory, and Sales Challans.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5002/api",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login (Sales)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"sales@fundsroom.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login (Warehouse)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"warehouse@fundsroom.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login (Accounts)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"accounts@fundsroom.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Register User (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Manager\",\n  \"email\": \"manager@fundsroom.com\",\n  \"password\": \"Password123\",\n  \"role\": \"SALES\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Get Current User Profile (/me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Customers CRM",
			"item": [
				{
					"name": "Get Customers (Paginated + Filter)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/customers?page=1&limit=10&search=Acme&status=ACTIVE",
							"host": ["{{baseUrl}}"],
							"path": ["customers"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "search", "value": "Acme" },
								{ "key": "status", "value": "ACTIVE" }
							]
						}
					}
				},
				{
					"name": "Get Customer By ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/customers/:id",
							"host": ["{{baseUrl}}"],
							"path": ["customers", ":id"]
						}
					}
				},
				{
					"name": "Create Customer (Admin & Sales)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Smith\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"alice@apexdistributors.com\",\n  \"businessName\": \"Apex Distributors\",\n  \"gstNumber\": \"27AAAAA0000A1Z5\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"456 Supply Chain Way, Mumbai, MH\",\n  \"status\": \"ACTIVE\",\n  \"notes\": \"Key partner for West Zone distribution.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": ["{{baseUrl}}"],
							"path": ["customers"]
						}
					}
				},
				{
					"name": "Update Customer",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Smith\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"alice@apexdistributors.com\",\n  \"businessName\": \"Apex Distribution Pvt Ltd\",\n  \"gstNumber\": \"27AAAAA0000A1Z5\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"456 Supply Chain Way, Mumbai, MH\",\n  \"status\": \"ACTIVE\",\n  \"notes\": \"Updated business name and contact notes.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers/:id",
							"host": ["{{baseUrl}}"],
							"path": ["customers", ":id"]
						}
					}
				},
				{
					"name": "Add Follow-Up CRM Note",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Discussed Q3 shipment order volume. Sent revised pricing catalog.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers/:id/follow-ups",
							"host": ["{{baseUrl}}"],
							"path": ["customers", ":id", "follow-ups"]
						}
					}
				}
			]
		},
		{
			"name": "3. Products & Stock Inventory",
			"item": [
				{
					"name": "Get Products (Search + Low Stock Filter)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products?search=Widget&lowStock=true",
							"host": ["{{baseUrl}}"],
							"path": ["products"],
							"query": [
								{ "key": "search", "value": "Widget" },
								{ "key": "lowStock", "value": "true" }
							]
						}
					}
				},
				{
					"name": "Get Product By ID with Movements",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products/:id",
							"host": ["{{baseUrl}}"],
							"path": ["products", ":id"]
						}
					}
				},
				{
					"name": "Create Product (Admin & Warehouse)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ultra Component Z\",\n  \"sku\": \"CMP-Z-100\",\n  \"category\": \"Components\",\n  \"unitPrice\": 45.00,\n  \"currentStock\": 200,\n  \"minStockAlert\": 30,\n  \"location\": \"Aisle D, Shelf 4\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						}
					}
				},
				{
					"name": "Update Product Specs",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ultra Component Z (V2)\",\n  \"sku\": \"CMP-Z-100\",\n  \"category\": \"Components\",\n  \"unitPrice\": 48.50,\n  \"minStockAlert\": 40,\n  \"location\": \"Aisle D, Shelf 5\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products/:id",
							"host": ["{{baseUrl}}"],
							"path": ["products", ":id"]
						}
					}
				},
				{
					"name": "Adjust Stock Level (Stock Movement IN/OUT)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantityChanged\": 50,\n  \"reason\": \"Supplier restock intake\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products/:id/stock-movements",
							"host": ["{{baseUrl}}"],
							"path": ["products", ":id", "stock-movements"]
						}
					}
				},
				{
					"name": "Get Product Stock Movement Logs",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products/:id/movements",
							"host": ["{{baseUrl}}"],
							"path": ["products", ":id", "movements"]
						}
					}
				}
			]
		},
		{
			"name": "4. Sales Challans",
			"item": [
				{
					"name": "Get All Challans (With Status Filter)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/challans?status=CONFIRMED",
							"host": ["{{baseUrl}}"],
							"path": ["challans"],
							"query": [
								{ "key": "status", "value": "CONFIRMED" }
							]
						}
					}
				},
				{
					"name": "Get Challan By ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/challans/:id",
							"host": ["{{baseUrl}}"],
							"path": ["challans", ":id"]
						}
					}
				},
				{
					"name": "Create Challan (DRAFT or CONFIRMED)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"YOUR_CUSTOMER_UUID\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"YOUR_PRODUCT_UUID\",\n      \"quantity\": 10\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/challans",
							"host": ["{{baseUrl}}"],
							"path": ["challans"]
						}
					}
				},
				{
					"name": "Confirm Draft Challan (Deducts Stock)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/challans/:id/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["challans", ":id", "confirm"]
						}
					}
				},
				{
					"name": "Cancel Challan (Restores Stock)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/challans/:id/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["challans", ":id", "cancel"]
						}
					}
				}
			]
		}
	]
}
